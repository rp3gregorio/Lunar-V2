# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
.DS_Store

# Local scratch space (cloned upstream code, temp scripts) — never commit.
.scratch/

# Project data and artifacts — everything in data/ is external, but the
# manifest (README.md) is tracked so others can reproduce the contents.
# Bundled peer-reviewed reference tables (Huang 2022, Murty 2025, etc.)
# ship with the repo under data/reference/ and are version-controlled.
data/*
!data/README.md
!data/reference/
!data/reference/*.csv
outputs/*
!outputs/.gitkeep

# DEMs (large)
*.tif
*.TIF
*.img
*.IMG

# Scientific output
*.nc
*.h5
*.hdf5
*.npy
*.npz
figures/*.pdf
figures/*.png
figures/*.eps

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
